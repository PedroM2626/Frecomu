# Replit configuration file
# This tells Replit how to run your project

run = "python main.py"
entrypoint = "main.py"

[nix]
channel = "stable-22_11"

[env]
FLASK_ENV = "production"
FLASK_APP = "app.py"
PYTHONUNBUFFERED = "1"
PYTHONPATH = "."

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "pyproject.toml"]

[languages]

[languages.python3]
pattern = "**/*.py"

[languages.python3.languageServer]
start = "pylsp"

[deployment]
run = ["sh", "-c", "python main.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80